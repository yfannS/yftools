# yfTools 后端配置文件模板
# 复制为 config.yaml 并填写实际值

server:
  port: 8000
  mode: debug   # debug / release
  log_level: INFO  # DEBUG / INFO / WARN / ERROR

database:
  host: 127.0.0.1
  port: 3306
  name: yftools
  user: root
  password: ""

redis:
  host: 127.0.0.1
  port: 6379

jwt:
  secret: change-me-in-production
  expire: 168h

rate_limit:
  enabled: true
  prefix: md2html:auth:ratelimit
  register:
    ip_per_minute:
      limit: 5
      window: 1m
    ip_per_hour:
      limit: 20
      window: 1h
    username_per_hour:
      limit: 3
      window: 1h
  login:
    ip_per_minute:
      limit: 20
      window: 1m
    username_per_15m:
      limit: 10
      window: 15m
    fail_username_per_15m:
      limit: 5
      window: 15m
    fail_username_ip_per_5m:
      limit: 3
      window: 5m
